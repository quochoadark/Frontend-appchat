{
  "expo": {
    "name": "ChatApp",
    "slug": "my-chat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mychatapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#128C7E"
      },
      "package": "com.mychatapp"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
